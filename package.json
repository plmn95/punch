{
  "name": "punch-email",
  "version": "0.1.0",
  "description": "Grounded ecommerce email generation engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plmn95/punch.git"
  },
  "homepage": "https://github.com/plmn95/punch#readme",
  "bugs": {
    "url": "https://github.com/plmn95/punch/issues"
  },
  "keywords": [
    "email",
    "ecommerce",
    "anthropic",
    "claude",
    "generation",
    "react-email"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.17.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "punch": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --dry-run --json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@react-email/render": "2.1.0",
    "htmlparser2": "12.0.0",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/react": "19.3.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
